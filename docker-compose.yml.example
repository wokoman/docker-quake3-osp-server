quake3:
    image: git.michalkozak.cz/wokoman/quake3-osp-server
    container_name: q3aospserver
    restart: always
#   This will run a non-default OSP mode config, e.g. freezetag, instead of the default instagib.
#   command: +exec freezetag.cfg
#   To use your own server.cfg from the volume below, exec it instead.
#   command: +exec server.cfg
    ports:
        - "27960:27960/udp"
    volumes:
        - /path/to/pak0.pk3:/usr/share/games/quake3/baseq3/pak0.pk3
        - /path/to/server.cfg:/usr/share/games/quake3/osp/server.cfg
